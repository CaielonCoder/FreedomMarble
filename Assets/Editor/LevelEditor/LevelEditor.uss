.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(68, 138, 255);
}

.unity-button {
}

.behaviour-button {
    background-color: rgb(173, 99, 96);
    -unity-text-align: middle-center;
}

.behaviour-button .unity-toggle__label {
    align-items: stretch;
    background-size: 100% 100%;
}

.behaviour-button .unity-toggle__input {
    display: none;
}

.behaviour-button:checked {
    background-color: rgb(76, 154, 81);
    color: rgb(255, 255, 255);
    width: 50px;
    height: 50px;
}

.title {
    background-color: rgba(100, 119, 135, 0.475);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    font-size: 16px;
}

.container {
    flex-grow: 1;
    background-color: rgba(120, 120, 120, 0.235);
    margin-left: 10px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding-top: 10px;
    padding-left: 10px;
    padding-bottom: 10px;
    padding-right: 10px;
    align-self: center;
}
