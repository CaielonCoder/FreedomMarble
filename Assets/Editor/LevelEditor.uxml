<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Editor/LevelEditor.uss?fileID=7433441132597879392&amp;guid=c0e8778791a782f4fafda55e70599f96&amp;type=3#LevelEditor"/>
    <ui:Button text="Enable" name="EnableButton"/>
    <ui:VisualElement name="BehaviourButtons" style="flex-grow: 1; width: 200px; flex-direction: row; flex-wrap: wrap; height: auto; justify-content: center; align-content: flex-start;">
        <ui:Toggle label="" name="TopLeft" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="Top" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="TopRight" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="Left" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Button text="Face" name="Center" enabled="false" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="Right" enabled="true" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="BottomLeft" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="Bottom" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
        <ui:Toggle label="" name="BottomRight" value="true" class="behaviour-button" style="width: 50px; height: 50px;"/>
    </ui:VisualElement>
</ui:UXML>
